<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.proxmint</groupId>
  <artifactId>proxmint</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>proxmint</name>
  <description>Free proxy list client: HTTP, HTTPS, SOCKS4 and SOCKS5 proxies, each checked through a real request in the last 30 minutes, and a rotating ProxySelector for HttpClient. No dependencies.</description>
  <url>https://proxmint.com/free-proxies</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Proxmint</name>
      <email>support@proxmint.com</email>
      <organization>Proxmint</organization>
      <organizationUrl>https://proxmint.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/proxmint/free-proxy-list.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/proxmint/free-proxy-list.git</developerConnection>
    <url>https://github.com/proxmint/free-proxy-list/tree/main/java</url>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
